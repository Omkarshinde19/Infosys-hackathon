{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "gateway",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PYTHONPATH=.venv/lib/python3.13/site-packages",
        "python3",
        "-m",
        "uvicorn",
        "services.gateway.main:app",
        "--port",
        "8001"
      ],
      "port": 8001
    },
    {
      "name": "frontend",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "GATEWAY_URL=http://localhost:8001",
        "NEXT_PUBLIC_GATEWAY_WS=ws://localhost:8001/ws/live",
        "npm",
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "mlflow",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "MLFLOW_DISABLE_AGENT_HINT=1",
        "PYTHONPATH=.venv/lib/python3.13/site-packages",
        "python3",
        "-m",
        "mlflow",
        "ui",
        "--port",
        "5001"
      ],
      "port": 5001
    }
  ]
}