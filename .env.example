# Copy to .env and fill in. Qualcomm Cloud AI inference via Cirrascale AI Suite (https://aisuite.cirrascale.com).
INFERENCE_CLOUD_API_KEY=your-api-key
INFERENCE_CLOUD_ENDPOINT=https://aisuite.cirrascale.com/apis/v2
# Optional: Llama-3.3-70B (default), Llama-3.1-8B, DeepSeek-R1-Distill-Llama-70B, Qwen-QwQ-32B
LLM_MODEL=Llama-3.3-70B
# Offline backup model (./netheal ollama). Docker sets OLLAMA_URL itself; ./netheal dev uses localhost.
OLLAMA_MODEL=qwen2.5:7b
# Signs login sessions; keep it stable so restarts don't sign everyone out (./netheal start creates one).
JWT_SECRET=change-me
